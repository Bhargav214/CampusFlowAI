# ─────────────────────────────────────────────────────────────
# CampusFlow AI — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:root@localhost:5432/campus_flow

# JWT secret key — use a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-strong-random-secret-key

# Token algorithm (do not change unless you know what you're doing)
ALGORITHM=HS256

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins (comma-separated, no trailing slash)
# Example for production: https://your-frontend.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
